// Development environment configuration.
// No secrets belong in this file — only non-sensitive identifiers/URLs.
// The Gemini API key is never referenced here: it lives only on the backend.

API_BASE_URL = https://api-dev.kampusagi.app
FIREBASE_PROJECT_ID = kampusagi-dev
GEMINI_TEXT_MODEL = gemini-flash-latest
GEMINI_EMBEDDING_MODEL = gemini-embedding-latest
GOOGLE_SIGN_IN_CLIENT_ID = REPLACE_WITH_DEV_GOOGLE_CLIENT_ID
GOOGLE_SIGN_IN_URL_SCHEME = REPLACE_WITH_DEV_GOOGLE_REVERSED_CLIENT_ID
APP_ENVIRONMENT_NAME = development
