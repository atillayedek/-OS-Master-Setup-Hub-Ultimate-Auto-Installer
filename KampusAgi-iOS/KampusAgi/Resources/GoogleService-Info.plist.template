<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template only — NOT a real Firebase config.

  For each environment (Development/Staging/Production), download the real
  GoogleService-Info.plist from the matching Firebase project in the
  Firebase console and save it as `KampusAgi/Resources/GoogleService-Info.plist`
  before building that scheme. That file is environment-specific and is
  git-ignored (see .gitignore) — it is provisioned per build environment
  (locally, or injected by CI from a secrets store), never checked in here.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>API_KEY</key>
    <string>REPLACE_WITH_REAL_FIREBASE_API_KEY</string>
    <key>GCM_SENDER_ID</key>
    <string>REPLACE_WITH_REAL_SENDER_ID</string>
    <key>PLIST_VERSION</key>
    <string>1</string>
    <key>BUNDLE_ID</key>
    <string>com.kampusagi.app</string>
    <key>PROJECT_ID</key>
    <string>REPLACE_WITH_REAL_FIREBASE_PROJECT_ID</string>
    <key>STORAGE_BUCKET</key>
    <string>REPLACE_WITH_REAL_PROJECT.appspot.com</string>
    <key>IS_ADS_ENABLED</key>
    <false/>
    <key>IS_ANALYTICS_ENABLED</key>
    <false/>
    <key>IS_APPINVITE_ENABLED</key>
    <false/>
    <key>IS_GCM_ENABLED</key>
    <true/>
    <key>IS_SIGNIN_ENABLED</key>
    <true/>
    <key>GOOGLE_APP_ID</key>
    <string>REPLACE_WITH_REAL_GOOGLE_APP_ID</string>
</dict>
</plist>
